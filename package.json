{
  "name": "hdu-library-sniper",
  "version": "2.0.30",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "server": "bun run src/server/index.ts",
    "server:dev": "bun --watch src/server/index.ts",
    "local": "bun run build && bun run server",
    "podman:build": "bash scripts/podman-build.sh",
    "podman:up": "bash scripts/podman-up.sh",
    "podman:down": "bash scripts/podman-down.sh",
    "podman:auto-update": "bash scripts/podman-auto-update.sh",
    "podman:auto-update:install": "bash scripts/install-podman-auto-update.sh",
    "podman:auto-update:uninstall": "bash scripts/uninstall-podman-auto-update.sh",
    "podman:auto-update:status": "bash scripts/podman-auto-update-status.sh",
    "autostart:install": "bash scripts/install-systemd-autostart.sh",
    "autostart:uninstall": "bash scripts/uninstall-systemd-autostart.sh",
    "tauri": "tauri",
    "build:server": "bun build src/server/index.ts --compile --outfile dist/hdu-sniper-server.exe"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@fontsource/dm-sans": "^5.3.0",
    "@hookform/resolvers": "^5.9.1",
    "@tabler/icons-react": "^3.50.0",
    "@tanstack/react-query": "^5.102.8",
    "@tanstack/react-router": "^1.170.32",
    "@tauri-apps/api": "^2.8.0",
    "@tauri-apps/plugin-http": "^2.6.0",
    "@tauri-apps/plugin-log": "^2.9.1",
    "@tauri-apps/plugin-notification": "^2.3.0",
    "@tauri-apps/plugin-opener": "^2.5.5",
    "@tauri-apps/plugin-updater": "^2.9.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "motion": "^13.1.1",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-hook-form": "^7.87.0",
    "tailwind-merge": "^3.6.0",
    "vite-plugin-pwa": "^1.3.0",
    "zod": "^4.5.4",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.5",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2.8.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@types/bun": "^1.2.21",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^4.3.4",
    "happy-dom": "^21.0.4",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.6",
    "vitest": "^4.1.11"
  }
}
