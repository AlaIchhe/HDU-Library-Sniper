{
  "name": "hdu-library-sniper",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "api:types": "openapi-typescript openapi.yaml -o src/web/generated/api.d.ts",
    "api:client": "orval --config orval.config.ts",
    "server": "bun run src/server/index.ts",
    "server:dev": "bun --watch src/server/index.ts",
    "booking-run": "bun run src/server/cli.ts booking-run",
    "local": "bun run build && bun run server",
    "podman:build": "bash scripts/podman-build.sh",
    "podman:up": "bash scripts/podman-up.sh",
    "podman:down": "bash scripts/podman-down.sh",
    "scheduler:install": "bash scripts/install-systemd-scheduler.sh",
    "scheduler:uninstall": "bash scripts/uninstall-systemd-scheduler.sh",
    "scheduler:status": "bash scripts/systemd-scheduler-status.sh",
    "tauri": "tauri",
    "build:server": "bun build src/server/index.ts --compile --outfile dist/hdu-sniper-server.exe"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@daypicker/react": "^10.0.1",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/dm-sans": "^5.3.0",
    "@hookform/resolvers": "^5.9.1",
    "@phosphor-icons/react": "^2.1.10",
    "@sentry/react": "^10.73.0",
    "@tanstack/react-query": "^5.102.8",
    "@tanstack/react-router": "^1.170.32",
    "@tanstack/router-plugin": "^1.168.35",
    "@tauri-apps/api": "^2.8.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "geist": "^1.7.2",
    "lucide-react": "^1.38.0",
    "motion": "^13.1.1",
    "next-themes": "^0.4.6",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-hook-form": "^7.87.0",
    "tailwind-merge": "^3.6.0",
    "vite-plugin-pwa": "^1.3.0",
    "web-vitals": "^6.2.1",
    "zod": "^4.5.4",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/bun": "^1.2.21",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^4.3.4",
    "happy-dom": "^20.12.0",
    "msw": "^2.15.0",
    "openapi-typescript": "^7.13.0",
    "orval": "^8.27.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.6",
    "vitest": "^3.2.7"
  }
}
