{
  "name": "hdu-library-sniper",
  "version": "3.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "mygo dev",
    "build": "mygo build",
    "generate": "mygo generate",
    "dev:web": "vite",
    "build:web": "vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "server": "go run ./cmd/server",
    "local": "bun run build:web && go run ./cmd/server",
    "podman:build": "bash scripts/podman-build.sh",
    "podman:up": "bash scripts/podman-up.sh",
    "podman:down": "bash scripts/podman-down.sh",
    "podman:auto-update": "bash scripts/podman-auto-update.sh",
    "podman:auto-update:install": "bash scripts/install-podman-auto-update.sh",
    "podman:auto-update:uninstall": "bash scripts/uninstall-podman-auto-update.sh",
    "podman:auto-update:status": "bash scripts/podman-auto-update-status.sh",
    "autostart:install": "bash scripts/install-systemd-autostart.sh",
    "autostart:uninstall": "bash scripts/uninstall-systemd-autostart.sh"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@tanstack/react-query": "^5.102.8",
    "@tanstack/react-router": "^1.170.32",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "motion": "^13.1.1",
    "mygo-runtime": "^0.9.0",
    "qrcode.react": "^4.2.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.5",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^4.3.4",
    "babel-plugin-react-compiler": "^1.0.0",
    "happy-dom": "^21.0.4",
    "mygo-cli": "^0.9.0",
    "tailwindcss": "^4.3.3",
    "typescript": "7.1.0-beta",
    "vite": "^7.3.6",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.11"
  }
