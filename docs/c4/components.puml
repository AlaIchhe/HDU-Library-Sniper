@startuml
set separator none
title HDU Library Sniper - KMP Shared Core - Components

left to right direction

!include <C4/C4>
!include <C4/C4_Context>
!include <C4/C4_Component>

Container(HDULibrarySniper.DesktopApp, "Desktop App", $techn="Compose Desktop (JVM)", $descr="Windows/macOS 管理界面", $tags="", $link="")
Container(HDULibrarySniper.CLI, "CLI / Daemon", $techn="Kotlin JVM", $descr="无 UI 后台执行", $tags="", $link="")
Container(HDULibrarySniper.AndroidApp, "Android App", $techn="Compose + Android 原生壳", $descr="AlarmReceiver + FGS + BOOT_COMPLETED", $tags="", $link="")
Container(HDULibrarySniper.IOSApp, "iOS App", $techn="SwiftUI + KMP 共享框架", $descr="AppIntent + BGTask", $tags="", $link="")
Container(HDULibrarySniper.Server, "Server / Worker", $techn="Ktor (JVM)", $descr="HTTP API + 定时 worker", $tags="", $link="")

System(慧图图书馆平台, "慧图图书馆平台", $descr="提供登录、房间、座位、预约、签到、取消、状态查询等 HTTP API", $tags="", $link="")
System(杭电SSO, "杭电 SSO", $descr="统一身份认证，返回 CAS ticket 与会话 Cookie", $tags="", $link="")
System(微信Webhook, "微信 Webhook", $descr="接收抢座和签到结果通知", $tags="", $link="")
System(GitHubReleases, "GitHub Releases", $descr="发布新版本与安装包", $tags="", $link="")
System(OSTaskScheduler, "OS Task Scheduler", $descr="Windows Task Scheduler / cron / launchd / AlarmManager / BGTask", $tags="", $link="")

Container_Boundary(HDULibrarySniper.CoreBoundary, "KMP Shared Core", $tags="") {
  Component(HDULibrarySniper.Core.Domain, "Domain", $techn="Kotlin", $descr="模型、业务规则、状态机与 DTO", $tags="", $link="")
  Component(HDULibrarySniper.Core.UseCases, "UseCases", $techn="Kotlin", $descr="用例编排：认证、方案、抢座、签到、复核、策略、通知、更新", $tags="", $link="")
  Component(HDULibrarySniper.Core.HuituClient, "HuituClient", $techn="Kotlin", $descr="慧图 HTTP 客户端与信封解析", $tags="", $link="")
  Component(HDULibrarySniper.Core.SSOClient, "SSOClient", $techn="Kotlin", $descr="CAS 登录客户端", $tags="", $link="")
  Component(HDULibrarySniper.Core.ApiSigning, "ApiSigning", $techn="Kotlin", $descr="bookSeats Api-Token 签名", $tags="", $link="")
  Component(HDULibrarySniper.Core.Persistence, "Persistence", $techn="Kotlin", $descr="仓库端口 + SQLite/DataStore 实现", $tags="", $link="")
  Component(HDULibrarySniper.Core.SecretsPort, "SecretsPort", $techn="Kotlin", $descr="平台安全存储端口", $tags="", $link="")
  Component(HDULibrarySniper.Core.Notifier, "Notifier", $techn="Kotlin", $descr="通知端口：微信 webhook、系统通知", $tags="", $link="")
  Component(HDULibrarySniper.Core.UpdateService, "UpdateService", $techn="Kotlin", $descr="版本比较、下载、SHA-256 校验", $tags="", $link="")
}

Rel(HDULibrarySniper.DesktopApp, HDULibrarySniper.Core.UseCases, "调用用例", $techn="", $tags="", $link="")
Rel(HDULibrarySniper.CLI, HDULibrarySniper.Core.UseCases, "调用用例", $techn="", $tags="", $link="")
Rel(HDULibrarySniper.AndroidApp, HDULibrarySniper.Core.UseCases, "调用用例", $techn="", $tags="", $link="")
Rel(HDULibrarySniper.IOSApp, HDULibrarySniper.Core.UseCases, "调用用例", $techn="", $tags="", $link="")
Rel(HDULibrarySniper.Server, HDULibrarySniper.Core.UseCases, "调用用例", $techn="", $tags="", $link="")
Rel(HDULibrarySniper.Core.UseCases, HDULibrarySniper.Core.Domain, "读写模型与规则", $techn="", $tags="", $link="")
Rel(HDULibrarySniper.Core.UseCases, HDULibrarySniper.Core.HuituClient, "远端查询/预约/签到", $techn="", $tags="", $link="")
Rel(HDULibrarySniper.Core.UseCases, HDULibrarySniper.Core.SSOClient, "CAS 登录", $techn="", $tags="", $link="")
Rel(HDULibrarySniper.Core.UseCases, HDULibrarySniper.Core.ApiSigning, "生成请求签名", $techn="", $tags="", $link="")
Rel(HDULibrarySniper.Core.UseCases, HDULibrarySniper.Core.Persistence, "读写本地数据", $techn="", $tags="", $link="")
Rel(HDULibrarySniper.Core.UseCases, HDULibrarySniper.Core.SecretsPort, "读写凭据", $techn="", $tags="", $link="")
Rel(HDULibrarySniper.Core.UseCases, HDULibrarySniper.Core.Notifier, "发送通知", $techn="", $tags="", $link="")
Rel(HDULibrarySniper.Core.UseCases, HDULibrarySniper.Core.UpdateService, "检查更新", $techn="", $tags="", $link="")
Rel(HDULibrarySniper.Core.HuituClient, HDULibrarySniper.Core.Persistence, "读写会话缓存", $techn="", $tags="", $link="")
Rel(HDULibrarySniper.Core.HuituClient, 慧图图书馆平台, "调用 HTTP API", $techn="", $tags="", $link="")
Rel(HDULibrarySniper.Core.SSOClient, 杭电SSO, "CAS 登录", $techn="", $tags="", $link="")
Rel(HDULibrarySniper.Core.Notifier, 微信Webhook, "发送通知", $techn="", $tags="", $link="")
Rel(HDULibrarySniper.Core.UpdateService, GitHubReleases, "检查更新", $techn="", $tags="", $link="")
Rel(HDULibrarySniper.CLI, OSTaskScheduler, "任务管理", $techn="", $tags="", $link="")
Rel(HDULibrarySniper.Server, OSTaskScheduler, "任务管理", $techn="", $tags="", $link="")
Rel(HDULibrarySniper.AndroidApp, OSTaskScheduler, "AlarmManager 调度", $techn="", $tags="", $link="")
Rel(HDULibrarySniper.IOSApp, OSTaskScheduler, "BGTask / 快捷指令", $techn="", $tags="", $link="")

SHOW_LEGEND(true)
@enduml
