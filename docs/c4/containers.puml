@startuml
set separator none
title HDU Library Sniper - Containers

left to right direction

!include <C4/C4>
!include <C4/C4_Context>
!include <C4/C4_Container>

System(慧图图书馆平台, "慧图图书馆平台", $descr="提供登录、房间、座位、预约、签到、取消、状态查询等 HTTP API", $tags="", $link="")
System(杭电SSO, "杭电 SSO", $descr="统一身份认证，返回 CAS ticket 与会话 Cookie", $tags="", $link="")
System(微信Webhook, "微信 Webhook", $descr="接收抢座和签到结果通知", $tags="", $link="")
System(GitHubReleases, "GitHub Releases", $descr="发布新版本与安装包", $tags="", $link="")
System(OSTaskScheduler, "OS Task Scheduler", $descr="Windows Task Scheduler / cron / launchd / AlarmManager / BGTask", $tags="", $link="")

System_Boundary("HDULibrarySniper_boundary", "HDU Library Sniper", $tags="") {
  Container(HDULibrarySniper.Core, "KMP Shared Core", $techn="Kotlin Multiplatform", $descr="业务核心：domain + usecases + library + persistence + secrets 端口", $tags="", $link="")
  Container(HDULibrarySniper.DesktopApp, "Desktop App", $techn="Compose Desktop (JVM)", $descr="Windows/macOS 管理界面", $tags="", $link="")
  Container(HDULibrarySniper.CLI, "CLI / Daemon", $techn="Kotlin JVM", $descr="无 UI 后台执行：run-now / checkin / daemon", $tags="", $link="")
  Container(HDULibrarySniper.AndroidApp, "Android App", $techn="Compose + Android 原生壳", $descr="AlarmReceiver + 前台服务 + BOOT_COMPLETED", $tags="", $link="")
  Container(HDULibrarySniper.IOSApp, "iOS App", $techn="SwiftUI + KMP 共享框架", $descr="AppIntent + BGTask + 快捷指令自动化", $tags="", $link="")
  Container(HDULibrarySniper.Server, "Server / Worker", $techn="Ktor (JVM)", $descr="HTTP API + 定时 worker", $tags="", $link="")
  Container(HDULibrarySniper.WebAdmin, "Web Admin", $techn="Ktor 静态资源 + 轻量前端", $descr="服务端形态下的管理界面", $tags="", $link="")

  Boundary(group_1, "Local Storage", $tags="Local Files") {
    Container(HDULibrarySniper.ConfigStore, "Config Store", $techn="SQLite / DataStore / YAML", $descr="普通配置", $tags="", $link="")
    Container(HDULibrarySniper.PlanStore, "Plan Store", $techn="SQLite / YAML", $descr="预约方案", $tags="", $link="")
    Container(HDULibrarySniper.CredentialStore, "Credential Store", $techn="平台安全存储", $descr="账号凭证", $tags="", $link="")
    Container(HDULibrarySniper.SessionStore, "Session Store", $techn="SQLite / DataStore", $descr="Cookie 与会话缓存", $tags="", $link="")
    Container(HDULibrarySniper.LogStore, "Audit Log", $techn="SQLite / 文本文件", $descr="运行与审计日志", $tags="", $link="")
  }
}

Rel(HDULibrarySniper.DesktopApp, HDULibrarySniper.Core, "调用共享核心", $techn="", $tags="", $link="")
Rel(HDULibrarySniper.CLI, HDULibrarySniper.Core, "调用共享核心", $techn="", $tags="", $link="")
Rel(HDULibrarySniper.AndroidApp, HDULibrarySniper.Core, "调用共享核心", $techn="", $tags="", $link="")
Rel(HDULibrarySniper.IOSApp, HDULibrarySniper.Core, "调用共享核心", $techn="", $tags="", $link="")
Rel(HDULibrarySniper.Server, HDULibrarySniper.Core, "调用共享核心", $techn="", $tags="", $link="")
Rel(HDULibrarySniper.WebAdmin, HDULibrarySniper.Server, "浏览管理界面", $techn="", $tags="", $link="")
Rel(HDULibrarySniper.Core, HDULibrarySniper.ConfigStore, "读写普通配置", $techn="", $tags="", $link="")
Rel(HDULibrarySniper.Core, HDULibrarySniper.PlanStore, "读写预约方案", $techn="", $tags="", $link="")
Rel(HDULibrarySniper.Core, HDULibrarySniper.CredentialStore, "读写账号凭证", $techn="", $tags="", $link="")
Rel(HDULibrarySniper.Core, HDULibrarySniper.SessionStore, "读写 Cookie 与会话", $techn="", $tags="", $link="")
Rel(HDULibrarySniper.Core, HDULibrarySniper.LogStore, "写入审计日志", $techn="", $tags="", $link="")
Rel(HDULibrarySniper.Core, 慧图图书馆平台, "调用 HTTP API", $techn="", $tags="", $link="")
Rel(HDULibrarySniper.Core, 杭电SSO, "CAS 登录", $techn="", $tags="", $link="")
Rel(HDULibrarySniper.Core, 微信Webhook, "发送通知", $techn="", $tags="", $link="")
Rel(HDULibrarySniper.Core, GitHubReleases, "检查更新", $techn="", $tags="", $link="")
Rel(HDULibrarySniper.CLI, OSTaskScheduler, "任务管理", $techn="", $tags="", $link="")
Rel(HDULibrarySniper.Server, OSTaskScheduler, "任务管理", $techn="", $tags="", $link="")
Rel(HDULibrarySniper.AndroidApp, OSTaskScheduler, "AlarmManager 调度", $techn="", $tags="", $link="")
Rel(HDULibrarySniper.IOSApp, OSTaskScheduler, "BGTask / 快捷指令", $techn="", $tags="", $link="")

SHOW_LEGEND(true)
@enduml
