{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default desktop permissions",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "notification:default",
    "updater:default",
    "window-state:default",
    "log:default",
    "opener:default",
    {
      "identifier": "http:default",
      "allow": [{ "url": "http://127.0.0.1:8000/*" }]
    }
  ]
}
