{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "HDU Library Sniper",
  "version": "2.0.14",
  "identifier": "io.github.alaichhe.hdu-library-sniper",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build && bun run build:server",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../dist/web"
  },
  "app": {
    "windows": [
      {
        "title": "HDU Library Sniper",
        "width": 1180,
        "height": 760,
        "minWidth": 760,
        "minHeight": 560,
        "visible": true,
        "center": true
      }
    ],
    "security": { "csp": null },
    "trayIcon": { "id": "main", "iconPath": "icons/icon.png", "showMenuOnLeftClick": false }
  },
  "bundle": {
    "active": true,
    "targets": ["msi"],
    "createUpdaterArtifacts": true,
    "icon": ["icons/icon.ico", "icons/icon.png"],
    "resources": { "../dist/hdu-sniper-server.exe": "hdu-sniper-server.exe" },
    "windows": { "wix": { "language": "zh-CN", "upgradeCode": "1A2C9174-90BF-55BB-9D8B-8CFE5B6CA1F9", "componentRefs": ["CMP_UpgradeMigrate", "CMP_StartupEntry"], "fragmentPaths": ["wix-fragments/upgrade-migrate.wxs", "wix-fragments/startup.wxs"] } }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDRGRDY2MjM1NTMyNUY0OTkKUldTWjlDVlROV0xXVCtDMmt2SGRYVjFvYk1IVmQ1aytFTnFOajM0cHM4amRCbSs0L0tNMlZ3ZUsK",
      "endpoints": ["https://github.com/AlaIchhe/HDU-Library-Sniper/releases/latest/download/latest.json"]
    }
  }
}
