{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "HDU Library Sniper",
  "version": "2.1.7",
  "identifier": "io.github.alaichhe.hdu-library-sniper",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../dist/web"
  },
  "app": {
    "windows": [
      {
        "title": "HDU Library Sniper",
        "width": 1180,
        "height": 760,
        "minWidth": 760,
        "minHeight": 560,
        "visible": true,
        "center": true
      }
    ],
    "security": { "csp": null },
    "trayIcon": { "id": "main", "iconPath": "icons/icon.png", "showMenuOnLeftClick": false }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "category": "Education",
    "icon": ["icons/icon.icns", "icons/icon.ico", "icons/icon.png"],
    "windows": {
      "nsis": {
        "installMode": "perMachine",
        "languages": ["SimpChinese"],
        "displayLanguageSelector": false,
        "installerHooks": "nsis/hooks.nsh"
      }
    },
    "macOS": {
      "minimumSystemVersion": "11.0",
      "signingIdentity": "-",
      "hardenedRuntime": false,
      "dmg": {
        "appPosition": { "x": 180, "y": 170 },
        "applicationFolderPosition": { "x": 480, "y": 170 },
        "windowSize": { "width": 660, "height": 400 }
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDRGRDY2MjM1NTMyNUY0OTkKUldTWjlDVlROV0xXVCtDMmt2SGRYVjFvYk1IVmQ1aytFTnFOajM0cHM4amRCbSs0L0tNMlZ3ZUsK",
      "endpoints": ["https://github.com/AlaIchhe/HDU-Library-Sniper/releases/latest/download/latest.json"]
    }
  }
}
