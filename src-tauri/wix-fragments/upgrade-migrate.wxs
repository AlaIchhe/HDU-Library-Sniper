<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
  <Fragment>
    <!--
      Upgrade/migration helpers for the HDU Library Sniper MSI.

      Background
      The app hides in the tray while the Rust HTTP server runs inside the Tauri
      process, so simply installing a newer MSI over an older one does not
      reliably replace the binaries if the old app is still running (the .exe
      stays locked). The legacy hdu-sniper-server process is still stopped for
      users upgrading from a sidecar build. In
      addition, the very first releases (v1.x) were distributed as Inno Setup
      installers, which are a different product on Windows from this MSI, so the
      MSI used to leave the old install in place and the user would keep
      launching the old version.

      What these custom actions do during every fresh install/upgrade:
      1. StopRunningApp      kills the running app (and any legacy sidecar) so files can be replaced.
      2. UninstallLegacySetup silently uninstalls leftover non-MSI (Inno/NSIS)
         "HDU Library Sniper" before the MSI files are installed.

      Both run through WiX's CAQuietExec instead of a bare ExeCommand: a plain
      ExeCommand creates the PowerShell console window before -WindowStyle
      Hidden takes effect, which made setup flash two extra terminal windows.
      CAQuietExec starts the process with a hidden window from the beginning.
      The property name must match the action id so MSI hands the command line
      to the deferred action as CustomActionData.
    -->
    <Property Id="StopRunningApp" Value="powershell.exe -NoProfile -ExecutionPolicy Bypass -WindowStyle Hidden -EncodedCommand " />
    <CustomAction
      Id="StopRunningApp"
      BinaryKey="WixCA"
      DllEntry="CAQuietExec"
      Execute="deferred"
      Impersonate="yes"
      Return="ignore" />
    <Property Id="UninstallLegacySetup" Value="powershell.exe -NoProfile -ExecutionPolicy Bypass -WindowStyle Hidden -EncodedCommand ... (line truncated to 2000 chars)
    <CustomAction
      Id="UninstallLegacySetup"
      BinaryKey="WixCA"
      DllEntry="CAQuietExec"
      Execute="deferred"
      Impersonate="yes"
      Return="ignore" />
    <InstallExecuteSequence>
      <Custom Action="StopRunningApp" Before="InstallFiles">NOT Installed AND NOT REMOVE</Custom>
      <Custom Action="UninstallLegacySetup" After="StopRunningApp">NOT Installed AND NOT REMOVE</Custom>
    </InstallExecuteSequence>
    <!-- Placeholder component that forces WiX light.exe to link this fragment
         into the MSI. WiX only includes fragment symbols that are referenced,
         so without a referenced component the custom actions above were silently
         dropped during bundling. -->
    <DirectoryRef Id="INSTALLDIR">
      <Component Id="CMP_UpgradeMigrate" Guid="81FB1734-6AB4-44CB-8BF7-C2D331D4587B">
        <RegistryValue Root="HKCU" Key="Software\github\HDU Library Sniper" Name="UpgradeMigrate" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </DirectoryRef>
  </Fragment>
</Wix>