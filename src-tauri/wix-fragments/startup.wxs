<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
  <Fragment>
    <!--
      Install-time autostart. The UI exposes no autostart toggle, so the MSI owns
      the per-user HKCU Run entry of the installing user:
        - fresh install and upgrades (re)write the entry, so it always points at
          the freshly installed exe path;
        - uninstall removes the component and with it the Run value;
        - disabling autostart is out of app scope: delete the Run value manually.
      The value is written as a plain RegistryValue component. An earlier
      revision spawned the app with the install-startup argument from a
      deferred custom action, but that failed silently inside msiexec
      (Return=ignore hid it),
      so the registry write no longer depends on launching the exe.
    -->
    <DirectoryRef Id="INSTALLDIR">
      <Component Id="CMP_StartupEntry" Guid="7E1A4C2D-9B3F-4D8A-A6E5-1C2B3D4E5F60">
        <RegistryValue
          Root="HKCU"
          Key="Software\Microsoft\Windows\CurrentVersion\Run"
          Name="HDU-Library-Sniper"
          Type="string"
          Value='"[INSTALLDIR]hdu-library-sniper.exe" --background'
          KeyPath="yes" />
      </Component>
    </DirectoryRef>
    <!--
      RestartHduApp: the updater flow runs this MSI while the app is running, and
      StopRunningApp (upgrade-migrate.wxs) kills it mid-install, so the webview
      cannot relaunch itself. An IMMEDIATE action sequenced after InstallFinalize
      runs once the script has executed and the freshly copied files are on disk
      (ICE77 forbids deferred actions there). cmd.exe resolves via PATH; `start`
      detaches so msiexec can exit while the new app keeps running.
    -->
    <CustomAction
      Id="RestartHduApp"
      Directory="INSTALLDIR"
      ExeCommand="cmd.exe /c start hdu-library-sniper.exe --background"
      Execute="immediate"
      Impersonate="yes"
      Return="asyncNoWait" />
    <InstallExecuteSequence>
      <Custom Action="RestartHduApp" After="InstallFinalize">NOT Installed AND NOT REMOVE</Custom>
    </InstallExecuteSequence>
  </Fragment>
</Wix>
