<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
  <Fragment>
    <!--
      Install-time autostart. The UI exposes no autostart toggle, so the MSI owns
      the per-user HKCU Run entry of the installing user:
        - fresh install and upgrades (re)write the entry, so it always points at
          the freshly installed exe path;
        - uninstall removes it, unless this uninstall is part of a major upgrade
          (UPGRADINGPRODUCTCODE is set on the old product) where the new package
          rewrites the entry right after;
        - disabling autostart is out of app scope: delete the Run value manually.
      Custom actions use the Directory+ExeCommand form because Tauri's generated
      mainBinary FileKey id is not stable across builds. Impersonate=yes keeps
      the per-user write elevation-free; Return=ignore never fails the MSI over
      autostart.
    -->
    <CustomAction
      Id="CreateHduStartupTask"
      Directory="INSTALLDIR"
      ExeCommand="hdu-library-sniper.exe --install-startup"
      Execute="deferred"
      Impersonate="yes"
      Return="ignore" />
    <CustomAction
      Id="DeleteHduStartupTask"
      Directory="INSTALLDIR"
      ExeCommand="hdu-library-sniper.exe --uninstall-startup"
      Execute="deferred"
      Impersonate="yes"
      Return="ignore" />
    <InstallExecuteSequence>
      <Custom Action="CreateHduStartupTask" After="InstallFiles">NOT Installed AND NOT REMOVE</Custom>
      <Custom Action="RestartHduApp" After="InstallFinalize">NOT Installed AND NOT REMOVE</Custom>
      <Custom Action="DeleteHduStartupTask" Before="RemoveFiles">REMOVE="ALL" AND NOT UPGRADINGPRODUCTCODE</Custom>
    </InstallExecuteSequence>
    <!--
      RestartHduApp: the updater flow runs this MSI while the app is running, and
      StopRunningApp (upgrade-migrate.wxs) kills it mid-install, so the webview
      cannot relaunch itself. After the install commits, bring the freshly
      installed app back in background mode so the 20:00 anchor never goes dark.
      cmd.exe resolves via PATH; `start` detaches so msiexec can exit.
    -->
    <CustomAction
      Id="RestartHduApp"
      Directory="INSTALLDIR"
      ExeCommand="cmd.exe /c start hdu-library-sniper.exe --background"
      Execute="deferred"
      Impersonate="yes"
      Return="ignore" />
    <!-- Placeholder component that forces WiX light.exe to link this fragment
         into the MSI; without a referenced component the custom actions above
         are silently dropped during bundling (see upgrade-migrate.wxs). -->
    <DirectoryRef Id="INSTALLDIR">
      <Component Id="CMP_StartupEntry" Guid="7E1A4C2D-9B3F-4D8A-A6E5-1C2B3D4E5F60">
        <RegistryValue Root="HKCU" Key="Software\github\HDU Library Sniper" Name="StartupEntry" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </DirectoryRef>
  </Fragment>
</Wix>
